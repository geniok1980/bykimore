FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps minimal
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy minimal requirements for the fetcher and install
COPY requirements-fetcher.txt ./
RUN pip install --no-cache-dir -r requirements-fetcher.txt

# Copy the fetcher script
COPY test_iiko_server_fetch.py ./

# Default command: run continuously without args (sales-dynamic mode)
CMD ["python", "-u", "test_iiko_server_fetch.py"]