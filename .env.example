# SECRET KEY for JWT (change in production!)
SECRET_KEY=your-secret-key-change-in-production

# CORS origins for backend (JSON array of allowed origins)
# BACKEND_CORS_ORIGINS=["http://your-domain.com:3100","http://your-ip:3100"]

# Public API URL for frontend (browser accesses this)
# NEXT_PUBLIC_API_URL=http://your-server-ip:8001/api/v1

# OLAP preset ID (UUID отчёта по продажам в iikoServer)
# IIKO_OLAP_PRESET_ID=
